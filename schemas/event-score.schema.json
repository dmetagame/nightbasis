{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nightbasis.local/schemas/event-score.schema.json",
  "title": "NightBasis Event Score v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prompt_version",
    "scorer_version",
    "temperature",
    "symbol",
    "as_of_et",
    "qualifying_event",
    "direction",
    "materiality",
    "confidence",
    "novelty_gate",
    "signed_info",
    "event_ids",
    "rationale",
    "cache_key"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "prompt_version": { "const": "event_score_v1" },
    "scorer_version": { "type": "string", "minLength": 1 },
    "temperature": { "const": 0 },
    "symbol": { "enum": ["RNVDAUSDT", "RTSLAUSDT", "RAAPLUSDT", "RGOOGLUSDT"] },
    "as_of_et": { "type": "string", "format": "date-time" },
    "qualifying_event": { "type": "boolean" },
    "direction": { "type": "integer", "minimum": -1, "maximum": 1 },
    "materiality": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "novelty_gate": { "type": "boolean" },
    "signed_info": { "type": "number", "minimum": -1, "maximum": 1 },
    "event_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "rationale": { "type": "string", "minLength": 1 },
    "cache_key": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
